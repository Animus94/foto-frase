# Copiar este archivo a `.env.local` (o `.env`) dentro de apps/public y completar
# con los valores reales del proyecto.
#
# Todas las variables de este archivo son PÚBLICAS por diseño: viajan en el
# bundle del cliente. El API Secret de Cloudinary y el Turnstile *secret key*
# NUNCA van acá — esos viven solo como secrets del Worker (ver worker/wrangler.toml
# y docs/deploy/RUNBOOK.md).
#
# Todavía no existen valores reales para este proyecto (ver docs/architecture/ADR-004
# y CLAUDE.md "Estado actual").

# Nombre de la cuenta de Cloudinary (ej. "dxxxxxxxx" o un nombre custom).
# Tomarlo del dashboard de Cloudinary (Settings > Account).
VITE_CLOUDINARY_CLOUD_NAME=

# URL base del mismo Cloudflare Worker que ya usa apps/backoffice (ADR-001).
# Desde ADR-004, apps/public TAMBIÉN depende de él: cada envío le pide una
# firma a `${VITE_WORKER_BASE_URL}/upload/sign` antes de subir a Cloudinary
# (reemplaza el upload preset unsigned que se usaba antes). Sin barra final.
# Ver docs/deploy/RUNBOOK.md para desplegar el Worker.
VITE_WORKER_BASE_URL=

# Site key pública del widget de Cloudflare Turnstile (ADR-004) — gatea el
# botón "Enviar" del paso de consentimiento. NO es secreta (a diferencia del
# Turnstile *secret key*, que solo vive como secret del Worker). Todavía no
# existe: falta crear el widget en el dashboard de Cloudflare (Turnstile >
# Add site) — ver docs/deploy/RUNBOOK.md.
VITE_TURNSTILE_SITE_KEY=
